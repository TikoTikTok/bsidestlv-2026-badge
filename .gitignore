# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- agent / tool local state ---
.claude/settings.local.json

# --- Python ---
__pycache__/
*.py[cod]

# --- Pico firmware (CMake) ---
software/controller/build/

# --- Node ---
node_modules/
npm-debug.log*

# --- KiCad ---
# Local, per-user project state - not part of the design.
*.kicad_prl
fp-info-cache
# Editor lock files and autosaves.
*.lck
~*
_autosave-*
# KiCad's own rolling zip archives. Git is the history.
*-backups/
production/backups/
# Recoverable rewrites KiCad leaves behind.
*.kicad_sch-bak
*.kicad_pcb-bak
# Autorouter scratch.
temp-freerouting.dsn
